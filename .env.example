# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# URL publique du site Monkomi (utilisée dans les codes d'intégration)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sites autorisés à afficher les widgets en iframe (séparés par des espaces). Vide = tous.
WIDGET_ALLOWED_ORIGINS=

# Connexion Google sur notre domaine (Google Cloud → Clients → client Web). Le secret reste côté serveur.
# Sans ces variables, la connexion Google passe par Supabase (Google affiche alors le domaine supabase.co).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pages légales (/mentions-legales, /conditions, /confidentialite, /sous-traitance) : identité de l'éditeur.
# Une valeur vide s'affiche « à compléter » sur les pages. Relancer un build après modification.
# Raison sociale (ex. Monkomi SRL) ou nom et prénom, forme juridique (ex. SRL), adresse du siège,
# numéro d'entreprise BCE (ex. 0123.456.789), TVA (optionnel), contact support et données personnelles.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_COMPANY_ID=
NEXT_PUBLIC_LEGAL_VAT=
NEXT_PUBLIC_LEGAL_EMAIL=

# Clé secrète Supabase (Project Settings → API Keys → Secret key, sb_secret_...). Côté serveur uniquement :
# e-mails programmés (rappels, avis) et liste d'attente.
SUPABASE_SECRET_KEY=

# E-mails aux clients — Resend (gratuit : 3 000 e-mails/mois, 100/jour).
# EMAIL_FROM = adresse d'expédition vérifiée chez le fournisseur (ex. reservations@monkomi.be).
EMAIL_FROM=
RESEND_API_KEY=

# Secret de la tâche programmée /api/cron (rappels, demandes d'avis, liste d'attente). Valeur aléatoire longue.
CRON_SECRET=

# Notifications sur téléphone (Web Push). Générer une paire : npx web-push generate-vapid-keys
# NEXT_PUBLIC_* : à renseigner AVANT le build (intégrée au code du navigateur).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
