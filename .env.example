# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# URL publique du site Baresto (utilisée dans les codes d'intégration)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sites autorisés à afficher les widgets en iframe (séparés par des espaces). Vide = tous.
WIDGET_ALLOWED_ORIGINS=

# Connexion Google sur notre domaine (Google Cloud → Clients → client Web). Le secret reste côté serveur.
# Sans ces variables, la connexion Google passe par Supabase (Google affiche alors le domaine supabase.co).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Page /confidentialite : identité de l'éditeur et contact données personnelles
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_EMAIL=
