# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# URL publique du site Baresto (utilisée dans les codes d'intégration)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sites autorisés à afficher les widgets en iframe (séparés par des espaces). Vide = tous.
WIDGET_ALLOWED_ORIGINS=

# Connexion Google sur notre domaine (Google Cloud → Clients → client Web). Le secret reste côté serveur.
# Sans ces variables, la connexion Google passe par Supabase (Google affiche alors le domaine supabase.co).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Page /confidentialite : identité de l'éditeur et contact données personnelles
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_EMAIL=

# Clé secrète Supabase (Project Settings → API Keys → Secret key, sb_secret_...). Côté serveur uniquement :
# e-mails programmés (rappels, avis) et liste d'attente.
SUPABASE_SECRET_KEY=

# E-mails aux clients — gratuit avec Brevo (300 e-mails/jour) ou Resend (3 000/mois). Une seule clé suffit.
# EMAIL_FROM = adresse d'expédition vérifiée chez le fournisseur (ex. reservations@bachba.be).
EMAIL_FROM=
BREVO_API_KEY=
RESEND_API_KEY=

# Secret de la tâche programmée /api/cron (rappels, demandes d'avis, liste d'attente). Valeur aléatoire longue.
CRON_SECRET=
